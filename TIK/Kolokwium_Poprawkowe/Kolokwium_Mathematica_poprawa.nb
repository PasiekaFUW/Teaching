Cell[CellGroupData[{

Cell["Zadanie 1 - Analiza funkcji, wykresy i uk\[LSlash]ady r\[OAcute]wna\
\:0144", "Chapter",
 CellChangeTimes->{{3.99103016406822*^9, 
  3.9910301965490074`*^9}},ExpressionUUID->"1de6a040-d9b3-f944-a078-\
744c09923316"],

Cell[TextData[{
 "\nDana jest funkcja:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"-", "x"}]], " ", 
     RowBox[{"sin", "(", 
      RowBox[{"3", "x"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "f892ec59-419a-4645-9704-b2e6905daca2"],
 "\n\na) Zdefiniuj t\:0119 funkcj\:0119 i narysuj jej wykres dla \
x\[Element][0,5]. Dodaj tytu\[LSlash] wykresu. (0.75 pkt)\n\nb) Dodaj \
etykiety osi. (0.75 pkt)\n\nc) Dodaj legend\:0119 opisuj\:0105c\:0105 obie \
funkcje. (0.75 pkt)\n\nd) Oblicz warto\:015b\[CAcute] pierwszej pochodnej \
funkcji w punkcie x=1. (0.75 pkt)\n\ne) Oblicz ca\[LSlash]k\:0119 oznaczon\
\:0105 funkcji na przedziale [0,5]. (0.75 pkt)"
}], "Text",
 CellChangeTimes->{
  3.991030118849325*^9, {3.991030191664747*^9, 3.991030195632248*^9}, {
   3.991030336365118*^9, 3.991030355907305*^9}, {3.9910339491840305`*^9, 
   3.991033958510744*^9}, {3.991034198388775*^9, 
   3.9910342064696083`*^9}},ExpressionUUID->"ac8dfff6-9e00-714d-b387-\
0f3f91112ca2"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"miejsce", " ", "na", " ", "rozwi\:0105zanie"}], "*)"}]], "Input",
 CellChangeTimes->{{3.9910304531547623`*^9, 
  3.991030464538723*^9}},ExpressionUUID->"ea997ee8-210c-6741-94ff-\
707f47c1941a"],

Cell[TextData[{
 "f) Rozwi\:0105\:017c poni\:017cszy uk\[LSlash]ad r\[OAcute]wna\:0144 i \
wyznacz wszystkie rozwi\:0105zania. (1 pkt):\n\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"]}], "=", "16"}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{"x", "+", "2"}]}], TraditionalForm]}],
  FormatType->TraditionalForm,ExpressionUUID->
  "3b5347a5-afb0-c04a-b401-8bd9c7da2c1e"]
}], "Text",
 CellChangeTimes->{{3.991030489208212*^9, 3.9910304911895714`*^9}, {
   3.9910338104908104`*^9, 3.9910338506216564`*^9}, {3.991034071056505*^9, 
   3.9910340776668377`*^9}, {3.9910342090281563`*^9, 3.9910342091656017`*^9}, 
   3.9910343924064426`*^9},ExpressionUUID->"0f73da0a-3e8e-a94a-8129-\
63a019bb48e9"],

